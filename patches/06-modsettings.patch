@@ -0,0 +1,142 @@
+package com.insta.mod;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Button;
+import android.widget.CompoundButton;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.Switch;
+import android.widget.TextView;
+import android.widget.Toast;
+
+public class ModSettingsActivity extends Activity {
+
+    private SharedPreferences prefs;
+
+    private int dp(int v) {
+        return (int) (v * getResources().getDisplayMetrics().density + 0.5f);
+    }
+
+    @Override
+    public void onCreate(Bundle b) {
+        super.onCreate(b);
+        prefs = getSharedPreferences("instamod", MODE_PRIVATE);
+
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        int pad = dp(20);
+        root.setPadding(pad, pad, pad, pad);
+        scroll.addView(root);
+
+        TextView title = new TextView(this);
+        title.setText("Insta Mod");
+        title.setTextSize(24);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        title.setTextColor(Color.BLACK);
+        root.addView(title);
+
+        TextView sub = new TextView(this);
+        sub.setText("Версия мода: " + ModUpdater.getLocalVersion(this));
+        sub.setTextSize(13);
+        sub.setTextColor(Color.GRAY);
+        sub.setPadding(0, dp(4), 0, dp(16));
+        root.addView(sub);
+
+        addSwitch(root,
+                "Не отмечать сториз просмотренными",
+                "Автор сториз не узнает, что вы её смотрели",
+                "no_story_seen", false);
+        addSwitch(root,
+                "Отключить детект скриншотов",
+                "Не отправлять уведомления о скриншотах в Direct и сториз",
+                "no_screenshot_detect", false);
+        addSwitch(root,
+                "Блокировать рекламу",
+                "Убирает рекламу из ленты, сториз и reels",
+                "no_ads", true);
+        addSwitch(root,
+                "Блокировать аналитику",
+                "Не отправлять события сбора статистики (logging_client_events)",
+                "no_analytics", false);
+
+        TextView note = new TextView(this);
+        note.setText("Изменения применяются на лету. При проблемах — перезапустите Insta.");
+        note.setTextSize(12);
+        note.setTextColor(Color.GRAY);
+        note.setPadding(0, dp(24), 0, 0);
+        root.addView(note);
+
+        Button updateBtn = new Button(this);
+        updateBtn.setText("Проверить обновления");
+        updateBtn.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                checkUpdates(true);
+            }
+        });
+        root.addView(updateBtn);
+
+        setContentView(scroll);
+
+        checkUpdates(false);
+    }
+
+    private void checkUpdates(final boolean manual) {
+        ModUpdater.check(this, new ModUpdater.CheckCallback() {
+            @Override
+            public void onUpdate(ModUpdater.Release rel, String localVersion) {
+                ModUpdater.showUpdateDialog(ModSettingsActivity.this, rel);
+            }
+
+            @Override
+            public void onUpToDate(String localVersion) {
+                if (manual) {
+                    Toast.makeText(ModSettingsActivity.this,
+                            "У вас последняя версия (" + localVersion + ")", Toast.LENGTH_SHORT).show();
+                }
+            }
+
+            @Override
+            public void onError(String message) {
+                if (manual) {
+                    Toast.makeText(ModSettingsActivity.this,
+                            "Не удалось проверить: " + message, Toast.LENGTH_LONG).show();
+                }
+            }
+        });
+    }
+
+    private void addSwitch(LinearLayout root, String label, String hint, final String key, boolean def) {
+        LinearLayout row = new LinearLayout(this);
+        row.setOrientation(LinearLayout.VERTICAL);
+        row.setPadding(0, dp(10), 0, dp(10));
+
+        Switch sw = new Switch(this);
+        sw.setText(label);
+        sw.setTextSize(16);
+        sw.setTextColor(Color.BLACK);
+        sw.setChecked(prefs.getBoolean(key, def));
+        sw.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
+            @Override
+            public void onCheckedChanged(CompoundButton btn, boolean on) {
+                prefs.edit().putBoolean(key, on).apply();
+            }
+        });
+        row.addView(sw);
+
+        TextView h = new TextView(this);
+        h.setText(hint);
+        h.setTextSize(12);
+        h.setTextColor(Color.GRAY);
+        h.setPadding(0, dp(2), 0, 0);
+        row.addView(h);
+
+        root.addView(row);
+    }
+}
diff --git a/modsrc/ModUpdater.java b/modsrc/ModUpdater.java
new file mode 100644
index 0000000000..9d46c92b2c
--- /dev/null
+++ b/modsrc/ModUpdater.java
@@ -0,0 +1,189 @@
+package com.insta.mod;
+
+import android.app.PendingIntent;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentSender;
+import android.content.pm.PackageInstaller;
+import android.os.Handler;
+import android.os.Looper;
+import android.widget.Toast;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+
+public class ModUpdater {
+
+    public static final String REPO = "Shvandre/insta-mod";
+    private static final String API = "https://api.github.com/repos/" + REPO + "/releases/latest";
+
+    public static class Release {
+        public String tag;
+        public String apkUrl;
+        public String notes;
+    }
+
+    public interface CheckCallback {
+        void onUpdate(Release rel, String localVersion);
+        void onUpToDate(String localVersion);
+        void onError(String message);
+    }
+
+    public static String getLocalVersion(Context ctx) {
+        try {
+            InputStream in = ctx.getAssets().open("instamod/version");
+            BufferedReader r = new BufferedReader(new InputStreamReader(in));
+            String v = r.readLine();
+            r.close();
+            return v == null ? "unknown" : v.trim();
+        } catch (Exception e) {
+            return "unknown";
+        }
+    }
+
+    public static void check(final Context ctx, final CheckCallback cb) {
+        final Handler ui = new Handler(Looper.getMainLooper());
+        final Context app = ctx.getApplicationContext();
+        final String local = getLocalVersion(app);
+        new Thread(new Runnable() {
+            @Override
+            public void run() {
+                HttpURLConnection conn = null;
+                try {
+                    conn = (HttpURLConnection) new URL(API).openConnection();
+                    conn.setRequestProperty("User-Agent", "insta-mod-updater");
+                    conn.setRequestProperty("Accept", "application/vnd.github+json");
+                    conn.setConnectTimeout(10000);
+                    conn.setReadTimeout(10000);
+                    int code = conn.getResponseCode();
+                    if (code != 200) {
+                        throw new Exception("GitHub API: HTTP " + code);
+                    }
+                    BufferedReader r = new BufferedReader(new InputStreamReader(conn.getInputStream()));
+                    StringBuilder sb = new StringBuilder();
+                    String line;
+                    while ((line = r.readLine()) != null) sb.append(line);
+                    r.close();
+
+                    JSONObject json = new JSONObject(sb.toString());
+                    final Release rel = new Release();
+                    rel.tag = json.getString("tag_name");
+                    rel.notes = json.optString("body", "");
+                    JSONArray assets = json.getJSONArray("assets");
+                    for (int i = 0; i < assets.length(); i++) {
+                        JSONObject a = assets.getJSONObject(i);
+                        if (a.getString("name").endsWith(".apk")) {
+                            rel.apkUrl = a.getString("browser_download_url");
+                            break;
+                        }
+                    }
+                    if (rel.apkUrl == null) {
+                        throw new Exception("В релизе " + rel.tag + " нет APK");
+                    }
+                    if (rel.tag.equals(local)) {
+                        ui.post(new Runnable() {
+                            @Override
+                            public void run() { cb.onUpToDate(local); }
+                        });
+                    } else {
+                        ui.post(new Runnable() {
+                            @Override
+                            public void run() { cb.onUpdate(rel, local); }
+                        });
+                    }
+                } catch (final Exception e) {
+                    ui.post(new Runnable() {
+                        @Override
+                        public void run() { cb.onError(e.getMessage()); }
+                    });
+                } finally {
+                    if (conn != null) conn.disconnect();
+                }
+            }
+        }).start();
+    }
+
+    public static void downloadAndInstall(final Context ctx, final Release rel) {
+        final Context app = ctx.getApplicationContext();
+        Toast.makeText(app, "Скачиваю " + rel.tag + "…", Toast.LENGTH_LONG).show();
+        new Thread(new Runnable() {
+            @Override
+            public void run() {
+                HttpURLConnection conn = null;
+                try {
+                    conn = (HttpURLConnection) new URL(rel.apkUrl).openConnection();
+                    conn.setRequestProperty("User-Agent", "insta-mod-updater");
+                    conn.setInstanceFollowRedirects(true);
+                    conn.connect();
+                    if (conn.getResponseCode() != 200) {
+                        throw new Exception("HTTP " + conn.getResponseCode());
+                    }
+                    File apk = new File(app.getCacheDir(), "update.apk");
+                    InputStream in = conn.getInputStream();
+                    FileOutputStream out = new FileOutputStream(apk);
+                    byte[] buf = new byte[65536];
+                    int n;
+                    while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+                    out.close();
+                    in.close();
+                    install(app, apk);
+                } catch (final Exception e) {
+                    new Handler(Looper.getMainLooper()).post(new Runnable() {
+                        @Override
+                        public void run() {
+                            Toast.makeText(app, "Ошибка загрузки: " + e.getMessage(), Toast.LENGTH_LONG).show();
+                        }
+                    });
+                } finally {
+                    if (conn != null) conn.disconnect();
+                }
+            }
+        }).start();
+    }
+
+    private static void install(Context ctx, File apk) throws Exception {
+        PackageInstaller installer = ctx.getPackageManager().getPackageInstaller();
+        PackageInstaller.SessionParams params = new PackageInstaller.SessionParams(
+                PackageInstaller.SessionParams.MODE_FULL_INSTALL);
+        int sessionId = installer.createSession(params);
+        PackageInstaller.Session session = installer.openSession(sessionId);
+        OutputStream out = session.openWrite("base.apk", 0, apk.length());
+        InputStream in = new java.io.FileInputStream(apk);
+        byte[] buf = new byte[65536];
+        int n;
+        while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+        session.fsync(out);
+        in.close();
+        out.close();
+
+        Intent intent = new Intent(ctx, ModSettingsActivity.class);
+        PendingIntent pi = PendingIntent.getActivity(ctx, sessionId, intent,
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+        IntentSender sender = pi.getIntentSender();
+        session.commit(sender);
+        session.close();
+    }
+
+    public static void showUpdateDialog(final Context ctx, final Release rel) {
+        String msg = "Доступна версия " + rel.tag;
+        if (rel.notes != null && rel.notes.length() > 0 && rel.notes.length() < 500) {
+            msg += "\n\n" + rel.notes;
+        }
+        new AlertDialog.Builder(ctx)
+                .setTitle("Обновление Insta Mod")
+                .setMessage(msg)
+                .setPositiveButton("Скачать и установить", (d, w) -> downloadAndInstall(ctx, rel))
+                .setNegativeButton("Позже", null)
+                .show();
+    }
+}
